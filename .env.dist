APP_NAME=gateway
OTEL_SERVICE_NAME=tic-tac-toe-gateway
APP_ENV=uat

GRPC_PORT=50051
HTTP_PORT=9090

SERVICE_AUTH_URL=auth:50051
SERVICE_BATTLE_URL=battle:50051
SERVICE_BOT_URL=bot:50051
SERVICE_ENGINE_URL=engine:50051
SERVICE_GATEWAY_URL=gateway:50051
SERVICE_MATCHMAKING_URL=matchmaking:50051
SERVICE_ORCHESTRATION_URL=orchestration:50051
SERVICE_PROFILE_URL=profile:50051
SERVICE_STREAMING_URL=streaming:50051

# Diagnostic endpoint /gateway/log (disabled by default)
# DEBUG_LOG_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://opentelemetry-collector:4318
PROMETHEUS_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTIC_INDEX=tic-tac-toe-uat.battle-operations
ELASTIC_MESSAGES_INDEX=tic-tac-toe-uat.service-messages
ELASTIC_ENABLED=true
